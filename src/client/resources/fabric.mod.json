{
  "schemaVersion": 1,
  "id": "litematicaplus",
  "version": "${version}",
  "name": "Litematica Plus LTS",
  "description": "Schematic holograms, area selection, verification, material lists, easy place and paste. A from-scratch, standalone replacement for Litematica that reads and writes .litematic files.",
  "authors": ["LTS_Server"],
  "license": "MIT",
  "icon": "assets/litematicaplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["org.lts.litematicaplus.LitematicaPlusClient"],
    "modmenu": ["org.lts.litematicaplus.compat.LitematicaPlusModMenu"],
    "jade": ["org.lts.litematicaplus.compat.JadeCompat"]
  },
  "mixins": ["litematicaplus.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-key-mapping-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v1": "*",
    "fabric-screen-api-v1": "*",
    "fabric-item-api-v1": "*",
    "fabric-networking-api-v1": "*"
  },
  "suggests": {
    "modmenu": "*",
    "jade": "*",
    "stackcalculator": "*",
    "inventoryprofilesnext": "*"
  }
}
